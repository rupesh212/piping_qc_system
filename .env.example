# Database
POSTGRES_DB=piping_qc
POSTGRES_USER=piping_user
POSTGRES_PASSWORD=changeme_in_production
DATABASE_URL=postgresql://piping_user:changeme_in_production@db:5432/piping_qc

# Backend
SECRET_KEY=your-secret-key-change-in-production-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# App
PROJECT_NAME=Piping QA/QC System

# Upload settings
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=50

# PgAdmin (optional)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
